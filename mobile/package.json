{
  "name": "pulse-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "rm -rf node_modules/.cache .expo && watchman watch-del-all 2>/dev/null || true",
    "doctor": "npx expo-doctor",
    "deps:fix": "npx expo install --fix",
    "deps:check": "./scripts/check-deps.sh",
    "postinstall": "node -e \"const fs = require('fs'); const path = require('path'); const pluginDir = path.join(__dirname, 'node_modules', 'react-native-worklets', 'plugin'); if (fs.existsSync(pluginDir) && !fs.existsSync(path.join(pluginDir, 'package.json'))) { fs.writeFileSync(path.join(pluginDir, 'package.json'), JSON.stringify({ main: './index.js', name: 'react-native-worklets-plugin' }, null, 2)); }\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@tanstack/react-query": "^5.17.0",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-device": "~8.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.22",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.468.0",
    "nativewind": "^2.0.11",
    "pulse-healthkit": "file:./pulse-healthkit",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gifted-charts": "^1.4.70",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "tailwindcss": "3.3.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
