{
  "name": "pulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.x",
  "description": "Pulse - Monorepo pour l'application mobile de suivi de santé",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "cd mobile && expo start",
    "start:clear": "cd mobile && expo start --clear",
    "android": "cd mobile && expo start --android",
    "ios": "cd mobile && expo start --ios",
    "web": "cd mobile && expo start --web",
    "doctor": "cd mobile && npx expo-doctor",
    "deps:fix": "cd mobile && npx expo install --fix",
    "deps:check": "cd mobile && ./scripts/check-deps.sh",
    "backend": "cd backend && ./start_backend.sh",
    "test:mobile": "cd mobile && npm test",
    "test:backend": "cd backend && pytest",
    "clean": "cd mobile && npm run clean"
  },
  "repository": {
    "type": "git",
    "url": "."
  },
  "keywords": [
    "health",
    "wellness",
    "mobile",
    "react-native",
    "expo",
    "healthkit"
  ]
}
